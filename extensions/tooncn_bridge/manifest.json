{
  "manifest_version": 3,
  "name": "Image Translator VN - ToonCN Bridge",
  "version": "0.3.0",
  "description": "ToonCN-only app-requested local browser connection. No cookies or external server.",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://tooncn.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gửi trang ToonCN cho Image Translator VN"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
