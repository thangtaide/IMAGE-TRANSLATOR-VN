# Python environments and generated files
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local data, test images, evidence and backup copies
/backup*/
/Backup*/
/ImgTest/
/cache/
/logs/
/output/
/dist/
/build/
/wheelhouse/
/tmp/
/temp/
/downloads/

# AI weights are downloaded/installed separately; models/README.md is source documentation
/models/ocr/**
/models/translation/**
# Keep model source, documentation and distributable manifests visible.
!/models/ocr/**/
!/models/translation/**/
!/models/ocr/**/*.py
!/models/translation/**/*.py
!/models/ocr/README.md
!/models/translation/README.md
!/models/ocr/**/*manifest*.json
!/models/translation/**/*manifest*.json
!/models/ocr/**/*checksum*.json
!/models/translation/**/*checksum*.json
!/models/ocr/**/*.sha256
!/models/translation/**/*.sha256
!/models/ocr/**/*.example.json
!/models/translation/**/*.example.json

# Machine settings and private tool/account configuration
/config/*
!/config/settings.example.json
.env
.env.*
!.env.example
.codex/
.agents/
.aws/
.idea/
.vscode/
*.pem
*.key
*.p12
*.pfx

# Runtime artifacts and temporary files
*.log
# Runtime databases live under /cache, /output, /logs or /config above.
# Do not hide SQLite fixtures or databases at unexpected source paths globally.
*.tmp
*.part
*.bak
*.orig
*.rej
*.whl
*.exe
*.dll
*.pyd
